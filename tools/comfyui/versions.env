# ローカル ComfyUI 環境の固定バージョン(docs/08-local-comfyui.md)
# 変更は単独の変更として行い、変更後に `npm run comfyui:setup` で動作確認すること。

# ComfyUI 本体(git タグ)
COMFYUI_TAG=v0.45.6

# ComfyUI-GGUF(タグが無いためコミットで固定)
GGUF_NODE_COMMIT=6ea2651e7df66d7585f6ffee804b20e92fb38b8a

# 顔補正(docs/10-assist-features.md)用のカスタムノード(コミットで固定)
# Impact Pack にはリリースタグが無いため、検証したコミットで固定する
IMPACT_PACK_COMMIT=9b4cb3a7c6969c1f4f128dc7fc87f92bc4ecfe16
# Impact Subpack 1.3.4
IMPACT_SUBPACK_COMMIT=5b4e55058ae48e18e1c6d974000461ad1e240135

# ControlNet の前処理(Depth / OpenPose。docs/10-assist-features.md)。リリースタグが無いためコミットで固定
CONTROLNET_AUX_COMMIT=c2655d2970d810d8a3d71deed204cdf416b66132

# 画像のタグ付け(WD14 Tagger。docs/39)。リリースタグが無いため、検証したコミットで固定する
WD14_TAGGER_COMMIT=9e0a6e700299182fc05c58b62e7ad9f72182a78b

# Python(メジャー.マイナー)
PYTHON_VERSION=3.12

# PyTorch(macOS は PyPI、Windows は TORCH_CUDA_INDEX の CUDA 版。ローカルバージョン +cuXXX は自動で一致する)
TORCH_VERSION=2.14.1
TORCHVISION_VERSION=0.29.1
TORCHAUDIO_VERSION=2.11.0
TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu130

COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI
GGUF_NODE_REPO=https://github.com/city96/ComfyUI-GGUF
IMPACT_PACK_REPO=https://github.com/ltdrdata/ComfyUI-Impact-Pack
IMPACT_SUBPACK_REPO=https://github.com/ltdrdata/ComfyUI-Impact-Subpack
CONTROLNET_AUX_REPO=https://github.com/Fannovel16/comfyui_controlnet_aux
WD14_TAGGER_REPO=https://github.com/pythongosssss/ComfyUI-WD14-Tagger
